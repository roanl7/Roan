---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEO from '@/components/SEO.astro';
import Hero from '@/components/Hero.astro';
import ProductGrid from '@/components/ProductGrid.astro';
import { CATEGORIES } from '@/data/site';
import { getCollection } from 'astro:content';

const category = CATEGORIES.find((c) => c.slug === 'audible')!;
const products = (await getCollection('products')).filter((p) => p.data.category === 'audible');
---

<BaseLayout>
  <Fragment slot="head">
    <SEO
      title="Audible & Audiobooks — ROAN"
      description="Audiobooks and listening picks for commutes, workouts, and quiet evenings in."
      path="/audible"
    />
  </Fragment>

  <Hero eyebrow="Category" title="Audible & Audiobooks" subtitle={category.description} />

  <section class="section">
    <div class="container">
      <ProductGrid products={products} columns={3} />
    </div>
  </section>
</BaseLayout>
