---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEO from '@/components/SEO.astro';
import Hero from '@/components/Hero.astro';
import ProductGrid from '@/components/ProductGrid.astro';
import { CATEGORIES } from '@/data/site';
import { getCollection } from 'astro:content';

const category = CATEGORIES.find((c) => c.slug === 'tools')!;
const products = (await getCollection('products')).filter((p) => p.data.category === 'tools');
---

<BaseLayout>
  <Fragment slot="head">
    <SEO
      title="Tools & Services — ROAN"
      description="Apps, platforms, and services that make modern life a little easier to manage."
      path="/tools"
    />
  </Fragment>

  <Hero eyebrow="Category" title="Tools & Services" subtitle={category.description} />

  <section class="section">
    <div class="container">
      <ProductGrid products={products} columns={3} />
    </div>
  </section>
</BaseLayout>
