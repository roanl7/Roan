---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEO from '@/components/SEO.astro';
import Hero from '@/components/Hero.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout>
  <Fragment slot="head">
    <SEO
      title="Journal — ROAN"
      description="Buying guides, comparisons, and editorial stories from ROAN."
      path="/journal"
    />
  </Fragment>

  <Hero
    eyebrow="Journal"
    title="Stories, guides & honest opinions"
    subtitle="Longer-form writing behind the product picks — buying guides, comparisons, and the occasional detour."
  />

  <section class="section">
    <div class="container">
      {articles.length > 0 ? (
        <div class="grid grid--3">
          {articles.map((a) => (
            <ArticleCard slug={a.slug} title={a.data.title} excerpt={a.data.excerpt} image={a.data.heroImage} />
          ))}
        </div>
      ) : (
        <p class="empty-state">New stories are on the way — check back soon.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .empty-state {
    text-align: center;
    color: var(--color-muted);
    padding: var(--space-4) 0;
  }
</style>
