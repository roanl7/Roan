---
interface Props {
  variant?: 'dark' | 'light';
  class?: string;
}
const { variant = 'dark', class: className = '' } = Astro.props;
const inkColor = variant === 'dark' ? '#1a1a1a' : '#f5f5f5';
---

<a href="/" class:list={['logo', className]} aria-label="ROAN — home">
  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M10 1L18.5 6V14L10 19L1.5 14V6L10 1Z" stroke="#C9A96E" stroke-width="1.2"/>
    <circle cx="10" cy="10" r="2.4" fill="#C9A96E"/>
  </svg>
  <span class="logo-word" style={`color:${inkColor}`}>ROAN</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .logo-word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: 0.06em;
  }
</style>
