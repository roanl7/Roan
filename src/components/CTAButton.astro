---
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'outline' | 'accent';
  external?: boolean;
}
const { href, label, variant = 'accent', external = true } = Astro.props;
const cls = `btn btn-${variant}`;
---

<a
  href={href}
  class={cls}
  {...external ? { target: '_blank', rel: 'sponsored noopener noreferrer' } : {}}
>
  {label}
</a>
