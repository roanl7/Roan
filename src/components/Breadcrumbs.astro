---
interface Crumb {
  label: string;
  path: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((item, i) => (
      <li>
        <span aria-hidden="true">/</span>
        {i === items.length - 1 ? (
          <span aria-current="page">{item.label}</span>
        ) : (
          <a href={item.path}>{item.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    font-size: 0.82rem;
    color: var(--color-muted);
  }
  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .breadcrumbs a:hover {
    color: var(--color-ink);
  }
  .breadcrumbs [aria-current='page'] {
    color: var(--color-ink);
  }
</style>
