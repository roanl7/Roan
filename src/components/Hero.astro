---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, subtitle, align = 'center' } = Astro.props;
---

<section class:list={['hero', `hero--${align}`]}>
  <div class="container hero-inner">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 set:html={title} />
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .hero {
    padding: var(--space-6) 0 var(--space-5);
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-border);
  }

  .hero-inner {
    max-width: 760px;
  }

  .hero--center {
    text-align: center;
    margin: 0 auto;
  }

  .hero--center .hero-inner {
    margin: 0 auto;
  }

  .hero-subtitle {
    font-size: 1.1rem;
    color: var(--color-muted);
    max-width: 56ch;
  }

  .hero--center .hero-subtitle {
    margin-left: auto;
    margin-right: auto;
  }
</style>
