---
interface Props {
  label: string;
  description: string;
  path: string;
}
const { label, description, path } = Astro.props;
---

<a href={path} class="category-card card">
  <h3>{label}</h3>
  <p>{description}</p>
  <span class="category-card-link">Explore {label} →</span>
</a>

<style>
  .category-card {
    display: block;
    padding: var(--space-4);
    height: 100%;
  }

  .category-card p {
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .category-card-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink);
  }
</style>
