---
interface Props {
  slug: string;
  title: string;
  excerpt: string;
  image?: { url: string; alt: string };
}
const { slug, title, excerpt, image } = Astro.props;
---

<article class="card article-card">
  <a href={`/journal/${slug}`} class="article-card-media">
    {image ? (
      <img src={image.url} alt={image.alt} loading="lazy" width="600" height="400" />
    ) : (
      <div class="article-card-placeholder" aria-hidden="true"></div>
    )}
  </a>
  <div class="article-card-body">
    <h3><a href={`/journal/${slug}`}>{title}</a></h3>
    <p>{excerpt}</p>
    <a href={`/journal/${slug}`} class="article-card-link">Read the story →</a>
  </div>
</article>

<style>
  .article-card-media {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-paper);
  }
  .article-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .article-card-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-paper), var(--color-border));
  }
  .article-card-body {
    padding: var(--space-3);
  }
  .article-card-body h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }
  .article-card-body p {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .article-card-link {
    font-size: 0.85rem;
    font-weight: 600;
  }
</style>
